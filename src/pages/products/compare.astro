---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/site';
const rows = ['Product role', 'Key functions', 'Boundary / control options', 'Connectivity requirements', 'Power & charging', 'Environmental protection', 'Certifications', 'MOQ / lead time'];
---
<BaseLayout title="Compare NAX100 & NAX101 | NAXWAVE"><section class="page-hero"><div class="wrap"><div class="eyebrow">Product comparison</div><h1>Find the right product for your range.</h1><p>Compare the NAX100 and NAX101 product lines. Details will be completed with approved technical and commercial information.</p></div></section><section class="section"><div class="wrap"><div style="overflow-x:auto"><table class="compare-table"><thead><tr><th>Comparison</th>{products.map((product)=><th><span class="product-code">{product.id}</span><br/>{product.title}</th>)}</tr></thead><tbody>{rows.map((row)=><tr><th>{row}</th><td>To be confirmed</td><td>To be confirmed</td></tr>)}</tbody></table></div><p class="form-note" style="margin-top:18px">Commercial conditions are subject to confirmation for each inquiry.</p><p style="margin-top:24px"><a class="button" href="/contact/">Ask for a comparison or sample <span>↗</span></a></p></div></section></BaseLayout>
<style>.compare-table{width:100%;border-collapse:collapse;border:1px solid var(--line);min-width:650px}.compare-table th,.compare-table td{padding:18px 20px;border-bottom:1px solid var(--line);border-right:1px solid var(--line);text-align:left;font-size:14px}.compare-table thead th{background:#f1f7fb;color:var(--ink);font:700 16px Manrope}.compare-table tbody th{background:#fafcfd;color:#38566d;font-size:13px}.compare-table td{color:#788b9a}</style>
