---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/site';
---
<BaseLayout>
  <section class="hero"><div class="wrap hero-inner"><div><div class="eyebrow">A dedicated pet safety business by NAXWAVE</div><h1>Built for safer<br/><em>outdoor freedom.</em></h1><p class="hero-copy">GPS pet safety products for brands, importers and distributors. Explore our product range and start a direct conversation with our team.</p><div class="hero-actions"><a class="button" href="/contact/">Discuss your project <span>↗</span></a><a class="button button-ghost" href="/products/nax100/">Explore products</a></div><div class="proof"><span>GPS pet safety focus</span><i></i><span>OEM / ODM inquiry welcome</span></div></div><div class="hero-art"><img src={products[0].image} alt="NAX100 product image placeholder"/><div class="float-card"><b>Product details</b>Technical information being prepared</div></div></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Product range</div><h2>Pet safety, purpose-built.</h2></div><p>Browse our dedicated GPS pet safety range. Confirmed specifications and commercial details will be added as they are approved.</p></div><div class="product-grid">{products.map((p)=><a class="product-card" href={`/products/${p.id.toLowerCase()}/`}><div class="product-image"><img src={p.image} alt={`${p.id} product image placeholder`}/></div><div class="product-body"><span class="product-code">{p.id}</span><h3>{p.title}</h3><p class="muted-box">Product description and technical details — to be provided.</p><span class="link-arrow">View product details ↗</span></div></a>)}</div></div></section>
  <section class="section capabilities"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Working together</div><h2>Your product line, supported.</h2></div><p>Tell us about your market and requirements. Our team will follow up with verified capability and cooperation information.</p></div><div class="three-grid"><article class="cap-card"><div class="cap-icon">⌖</div><h3>Product development</h3><p>R&D scope and engineering resources: to be confirmed.</p></article><article class="cap-card"><div class="cap-icon">⌂</div><h3>Manufacturing</h3><p>Production capacity, quality systems and facility details: to be confirmed.</p></article><article class="cap-card"><div class="cap-icon">↗</div><h3>OEM / ODM</h3><p>Customization options, minimum order and lead time: to be confirmed.</p></article></div><div style="margin-top:26px"><a class="link-arrow" href="/oem-odm/">Explore partnership information ↗</a></div></div></section>
  <section class="section"><div class="wrap"><div class="cta-band"><div><div class="eyebrow" style="color:#8cccf5">Start a conversation</div><h2>Planning your next pet safety product?</h2><p>Share your product, market or sample requirements with our team.</p></div><a class="button" href="/contact/">Send an inquiry <span>↗</span></a></div></div></section>
</BaseLayout>
