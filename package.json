{
  "name": "naxwave-pet-safety",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:pages": "wrangler pages dev dist",
    "d1:create": "wrangler d1 create naxwave-pet-inquiries",
    "d1:migrate:local": "wrangler d1 migrations apply naxwave-pet-inquiries --local",
    "d1:migrate:remote": "wrangler d1 migrations apply naxwave-pet-inquiries --remote",
    "deploy": "wrangler pages deploy dist --project-name naxwave-pet-safety"
  },
  "dependencies": { "astro": "^5.7.0" },
  "devDependencies": { "wrangler": "^4.59.2" }
}
